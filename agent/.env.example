# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# NeonDB (PostgreSQL with pgvector) Configuration
# Format: postgresql+psycopg://user:password@endpoint.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=postgresql+psycopg://username:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# LangGraph Server / LangSmith (Optional for local development)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ult-polsri-agent

# Model Configurations
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
